<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furever Email Activation</title>
    <style type="text/css">
        body {
            margin: 0;
            padding: 0;
            min-width: 100%;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 16px;
            line-height: 1.5;
            background-color: #fafafa;
            color: #222;
        }
        a{
            color : #000;
            text-decoration: none;
        }
        h1 {
            font-size: 24px;
            font-weight: 700;
            line-height: 1.25;
            margin-top: 0;
            margin-bottom: 15px;
            text-align: center;
        }
        p {
            margin-bottom: 24px;
        }
        table td {
            vertical-align: top;
        }
        .email-wrapper{
            max-width: 600px;
            margin: 0 auto;
        }
        .email-header{
            background-color: #0070f3;
            padding: 24px;
            color: #fff;
        }
        .email-body{
            padding: 24px;
            background-color: #fff;
        }
        .email-footer{
            background-color: #f6f6f6;
            padding: 24px;
        }
        .button{
            display: inline-block;
            background-color: #0070f3;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 4px;
        }
        
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-header">
            <h1>Welcome to Furever</h1>
        </div>
        <div class="email-body">
            <p>Hello <%= name %></p>
            <p>
                This otp is valid for the next 5 minutes. If you did not request a password reset, please ignore this email.
            </p>
            <h2><%= otp %></h2>
            <p>
               If you need any further assistance, please contact the support team.
            </p>
        </div>
        <div class="email-footer">
            <p>If you have any questions, please don't hesitate to contact us at </p>
            <a href="mailto:support@furever.com">support@furever.com</a>
        </div>
    </div>
</body>
</html>